# Copie este arquivo para ".env" (sem o .example) e ajuste os valores.
# O .env está no .gitignore: ele NUNCA vai para o GitHub.

# Qual provedor de dados o app usa. Opções: tvmaze, openlibrary, falso
PROVEDOR=tvmaze

# Arquivo do banco SQLite
DB_PATH=colecao.db

# Seu e-mail de contato. Algumas APIs pedem que você se identifique
# no cabeçalho User-Agent (ex.: Open Library, Art Institute).
CONTATO_EMAIL=seu-email@exemplo.com

# Só para a fase de chave de API (TMDB) — deixe vazio até lá
TMDB_API_KEY=
